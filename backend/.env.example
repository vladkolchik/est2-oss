# est2 env. Local dev: copy to backend/.env. Docker Compose: copy to .env in the repo root.
# Both are git-ignored: never commit real keys. On Coolify set these as env vars instead.

# ===== Docker Compose only (compose.yaml) =====
# Password of the bundled Postgres; compose builds DATABASE_URL from it. Use a URL-safe
# value, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# compose.standalone.yaml: host port / bind address of the app
#APP_PORT=3000
#APP_BIND=127.0.0.1
# Start the optional Silero TTS service too (then SILERO_TTS_URL=http://silero:3000/tts)
#COMPOSE_PROFILES=tts

# ===== World memory: Postgres + pgvector — the heart of the game =====
# The world service (turns, entities, relations, consequences, NPC state) and GraphRAG
# live here. Without DATABASE_URL they are OFF: no long-term memory, no cloud sessions.
# Needs the pgvector extension (e.g. image pgvector/pgvector:pg17). Create the schema with
# `node migrate.js` from backend/ (`--status` lists applied/pending migrations).
# Local example:
#   docker run -d --name est2-pg -e POSTGRES_PASSWORD=est2 -e POSTGRES_DB=est2 -p 5432:5432 pgvector/pgvector:pg17
#   DATABASE_URL=postgres://postgres:est2@localhost:5432/est2
DATABASE_URL=
#PG_POOL_MAX=10

# GraphRAG over the world graph
GRAPH_RAG_ENABLED=true
GRAPH_RAG_TIMEOUT_MS=60000
GRAPH_RAG_COMPLEX_ONLY=true
# Light-tier model for summaries; provider follows TEXT_PROVIDER
# (deepseek -> deepseek-v4-flash, gemini -> gemini-2.5-flash, OpenRouter -> OPENROUTER_LIGHT_MODEL)
GRAPH_RAG_SUMMARY_MODEL=deepseek-v4-flash
#GRAPH_RAG_SUMMARY_PROVIDER=deepseek
GRAPH_RAG_SUMMARY_TTL_TURNS=6
GRAPH_RAG_MAX_SCOPES=4
GRAPH_RAG_MAX_SUBGRAPH_NODES=80
GRAPH_RAG_MAX_SUBGRAPH_EDGES=140
GRAPH_RAG_JOB_BATCH=12
GRAPH_RAG_CACHE_WARM_ON_TURN=true
#NPC_REFLECTION_EVERY_N_EVENTS=4

# Embeddings for world memory: OPENAI_API_KEY (text-embedding-3-small), or OpenRouter
# (openai/text-embedding-3-small, same vectors) when only OPENROUTER_API_KEY is set.
OPENAI_API_KEY=

# Shared access key for the cloud session browser (/api/sessions*)
SESSIONS_ACCESS_KEY=

# ===== Text LLM =====
# Preferred provider: gemini (default) | deepseek. GM on the main model, light agents
# (GraphRAG summaries, scene artist) on the light tier.
TEXT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
#DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini: text (when TEXT_PROVIDER=gemini), AI images, Gemini TTS. API_KEY is a legacy alias.
GEMINI_API_KEY=
API_KEY=
#GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenRouter: one key for text, embeddings, AI images and Gemini voices. Used when the
# direct key for a job is missing (a player's own key always wins over a server key).
# Model families follow TEXT_PROVIDER; override with OpenRouter slugs if needed.
OPENROUTER_API_KEY=
#OPENROUTER_MODEL=deepseek/deepseek-v4-pro
#OPENROUTER_LIGHT_MODEL=deepseek/deepseek-v4-flash
#OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
#OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
#OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts

# "Artist" agent (scene descriptors for the parametric renderer); follows TEXT_PROVIDER.
#ARTIST_PROVIDER=deepseek
#ARTIST_MODEL=deepseek-v4-flash

# ===== BYOK (players' own keys from the API KEYS dialog) =====
# true: server keys are not used for player traffic; requests without their own key get 401.
BYOK_REQUIRED=false

# ===== TTS =====
#ELEVENLABS_API_KEY=
#GCP_TTS_API_KEY=
# Silero — auto-provisioned local server (backend/sileroManager.js). First start creates a
# venv + installs CPU torch (~1.5-2 GB, one-time) and downloads the model (~60-150 MB).
# Set SILERO_AUTOSTART=false to disable, or SILERO_TTS_URL to use an external server.
SILERO_AUTOSTART=true
SILERO_MODEL=v3_en
SILERO_SPEAKER=en_0
#SILERO_PORT=8010
#SILERO_THREADS=4
#SILERO_TTS_URL=http://127.0.0.1:8010/tts
